# Supabase Configuration (used by seeding & database utility scripts)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI Backend Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave blank for local development; set a strong random token in production
BACKEND_API_SECRET=

# Local AI Engine (Ollama + ChromaDB)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_DB_PATH=./local_legal_db

# Optional: password used when running scripts/seed_officers.js
# SEED_OFFICER_PASSWORD=ChangeMe123!
